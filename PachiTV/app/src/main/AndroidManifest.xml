<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Para la opción "Desinstalar" del menú de cada app (siempre pide confirmación) -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Para "Optimizar": cerrar procesos en segundo plano de otras apps -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />

    <!-- Para el pronóstico del tiempo -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Para abrir la pantalla de vincular dispositivos Bluetooth (se pide al usarlo) -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Solo se usan si se otorgan por ADB: animaciones y servicio del botón Inicio -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        xmlns:tools="http://schemas.android.com/tools"
        tools:ignore="ProtectedPermissions" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Android 11+: permiso para ver la lista de apps que se pueden abrir -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:banner="@drawable/banner_app"
        android:icon="@drawable/ic_app"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">

        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Para la isla dinámica: permite saber qué música suena. No lee notificaciones -->
        <service
            android:name=".MusicaListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Protector de pantalla: el logo rebotando en los bordes -->
        <service
            android:name=".ProtectorService"
            android:exported="true"
            android:label="@string/protector_nombre"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <activity
            android:name=".ProtectorActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <!-- Atrapa el botón Inicio: cuando aparece la pantalla de Google, abre este launcher -->
        <service
            android:name=".InicioService"
            android:exported="true"
            android:label="@string/servicio_nombre"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/inicio_service" />
        </service>
    </application>
</manifest>
